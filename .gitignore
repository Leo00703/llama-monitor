# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Local, machine-specific data (live config, presets, runtime state).
# New installs store these in the user-data dir (%APPDATA%/llama-monitor on
# Windows, ~/.config/llama-monitor elsewhere) — these entries only cover
# legacy in-repo layouts, which are auto-migrated on startup.
config.json
data/
*.log

# PyInstaller build artifacts (regenerated by build_exe.bat / CI)
build/
dist/
*.spec
# Baked at build time (GITHUB_SHA / local HEAD) — never source-tracked
backend/_buildinfo.json

# Update-recovery leftover (AGENTS.md gotcha: rename the locked running exe
# so git can rewrite it -> mv llama-monitor.exe .old.exe). The repo TRACKS
# exactly one exe (the repo-root llama-monitor.exe), so a blanket *.exe rule
# is impossible — this closes the gap narrowly. `*` also matches the leading
# dot, and covers variants ending in .old.exe (llama-monitor.old.exe).
# Delete the leftover after quitting the tray; the rule only prevents an
# accidental `git add -A` blob.
*.old.exe

# Local scratchpad / to-do (never committed)
TODO.md

# graphify knowledge graph (graphify-out/ IS committed — graph.json + report
# are the agent query target; only local artifacts are ignored)
graphify-out/cache/
graphify-out/.graphify_root
graphify-out/cost.json
graphify-out/memory/
# graphify's dated pre-run graph backups (local artifacts)
graphify-out/20*/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
